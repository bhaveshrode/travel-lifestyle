# Server Configuration
NODE_ENV=development
PORT=3001
API_VERSION=v1

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/travel_lifestyle?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Ethereum Configuration
ETHEREUM_NETWORK=localhost
ETHEREUM_RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Smart Contract Addresses (update after deployment)
TRAVEL_CARD_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
NFTS_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
POINTS_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# External APIs
COINGECKO_API_KEY=
CURRENCY_API_KEY=

# IPFS Configuration (for NFT metadata)
IPFS_GATEWAY=https://ipfs.io/ipfs/
PINATA_API_KEY=
PINATA_SECRET_KEY=
